# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- 运行期产物 / 数据（绝不入库；前导斜杠防止误伤 src/data 之类的路径）----
/runs/
/checkpoints/
/out/
/data/
/models/
/.cache/
*.pt
*.pth
*.safetensors
*.bin
