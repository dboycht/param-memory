# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- 运行期产物 / 数据（绝不入库；前导斜杠防止误伤 src/data 之类的路径）----
/runs/
/checkpoints/
/out/
/data/
/models/
/.cache/
*.pt
*.pth
*.safetensors
*.bin
*.log

# ---- 一次性开发脚本与草稿（只留开发副本）----
/_dev/
/_scratch/
/.scratch/

# ---- 论文编译中间产物（源码 paper/main.tex 与 paper/generated_tables.tex 入库；
#      PDF 与其余中间产物由 pdflatex 生成，不入库）----
#      教训：漏列 *.synctex.gz 时，一次提交就把这个构建产物推上了仓库。
/paper/*.aux
/paper/*.out
/paper/*.toc
/paper/*.pdf
/paper/*.txt
/paper/*.synctex.gz
/paper/*.fls
/paper/*.fdb_latexmk
/paper/*.bbl
/paper/*.blg
/paper/*.nav
/paper/*.snm
/paper/*.vrb

# ---- 开发副本专用文档（只留开发副本，不同步 GitHub）----
DEVELOPMENT.md
ERROR.md
HANDOVER.md

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
